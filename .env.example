# GitHub API Token (Optional, for collecting live issues without strict rate limits)
GITHUB_TOKEN=your_github_token_here

# LLM Provider API Keys (Configure at least one for live LLM analysis, else pipeline uses heuristic engine)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Ollama local endpoint configuration (Optional)
OLLAMA_BASE_URL=http://localhost:11434
